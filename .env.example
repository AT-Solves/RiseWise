# Copy to .env and fill in. Never commit the real .env.

# Which LLM backend RiseWise's reasoning modules call: "ollama" (default,
# self-hosted) or "anthropic". See docs/adr-0004-self-hosted-ollama-default.md.
RISEWISE_LLM_PROVIDER=ollama

# --- Ollama (self-hosted) --- used when RISEWISE_LLM_PROVIDER=ollama.
# Install from https://ollama.com, run `ollama serve`, then
# `ollama pull llama3.1` (or whichever model you set below).
RISEWISE_OLLAMA_HOST=http://localhost:11434
RISEWISE_OLLAMA_MODEL=llama3.1

# --- Anthropic API --- used when RISEWISE_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
RISEWISE_ANTHROPIC_MODEL=claude-sonnet-4-5
